{
  "notes": [
    "Placeholders: {base} = mock server URL, {closed} = an address nothing listens on,",
    "{expired_jwt} expired 1 h ago, {future_jwt} issued by a clock 3.5 min fast, {read_jwt},",
    "{tampered_jwt}: minted per case against the real clock, so every run is the same scenario.",
    "expect.category = the right answer. expect.mentions = words a correct explanation",
    "names (any one of them, case-insensitive, in summary or fix). 'hard' cases are ones",
    "no rule was written for: they measure what the LLM adds."
  ],
  "cases": [
    {"id": "b01", "audience": "beginner", "title": "no credentials at all",
     "curl": "curl {base}/v1/me",
     "expect": {"category": "auth_missing", "mentions": ["authorization", "token"]}},
    {"id": "b02", "audience": "beginner", "title": "token without 'Bearer '",
     "curl": "curl -H 'Authorization: good-token' {base}/v1/me",
     "expect": {"category": "auth_scheme", "mentions": ["bearer"]}},
    {"id": "b03", "audience": "beginner", "title": "'Bearer' written twice",
     "curl": "curl -H 'Authorization: Bearer Bearer good-token' {base}/v1/me",
     "expect": {"category": "auth_scheme", "mentions": ["twice", "duplicate"]}},
    {"id": "b04", "audience": "beginner", "title": "JSON sent with -d (form content type)",
     "curl": "curl -d '{\"name\": \"x\"}' {base}/v1/items", "allow_unsafe": true,
     "expect": {"category": "content_type", "mentions": ["application/json"]}},
    {"id": "b05", "audience": "beginner", "title": "quotes eaten by the shell",
     "curl": "curl -H 'Content-Type: application/json' -d '{name: x}' {base}/v1/items",
     "allow_unsafe": true,
     "expect": {"category": "malformed_body", "mentions": ["quote", "json"]}},
    {"id": "b06", "audience": "beginner", "title": "trailing comma in JSON",
     "curl": "curl --json '{\"name\": \"x\",}' {base}/v1/items", "allow_unsafe": true,
     "expect": {"category": "malformed_body", "mentions": ["json", "comma"]}},
    {"id": "b07", "audience": "beginner", "title": "API key in the query string",
     "curl": "curl '{base}/v1/keyed?api_key=good-key'",
     "expect": {"category": "api_key_location", "mentions": ["header", "x-api-key"]}},
    {"id": "b08", "audience": "beginner", "title": "API key header missing",
     "curl": "curl {base}/v1/keyed",
     "expect": {"category": "auth_missing", "mentions": ["x-api-key"]}},
    {"id": "b09", "audience": "beginner", "title": "typo in the path",
     "curl": "curl -H 'Authorization: Bearer good-token' {base}/v1/meee",
     "expect": {"category": "not_found", "mentions": ["path", "/v1/meee", "typo"]}},
    {"id": "b10", "audience": "beginner", "title": "GET on a POST-only endpoint",
     "curl": "curl {base}/v1/items",
     "expect": {"category": "method_not_allowed", "mentions": ["post"]}},
    {"id": "b11", "audience": "beginner", "title": "required field missing",
     "curl": "curl --json '{\"email\": \"a@b.c\"}' {base}/v1/users", "allow_unsafe": true,
     "expect": {"category": "validation", "mentions": ["age"]}},
    {"id": "b12", "audience": "beginner", "title": "nothing listening on that port",
     "curl": "curl -m 10 {closed}/v1/me",
     "expect": {"category": "connection", "mentions": ["port", "running", "connect"]}},

    {"id": "e01", "audience": "experienced", "title": "auth dropped on cross-host redirect",
     "curl": "curl -L -H 'Authorization: Bearer good-token' {base}/v1/old-me",
     "expect": {"category": "auth_dropped_on_redirect", "mentions": ["redirect"]}},
    {"id": "e02", "audience": "experienced", "title": "301 turns POST into GET",
     "curl": "curl -L --json '{\"a\": 1}' {base}/v1/old-items", "allow_unsafe": true,
     "expect": {"category": "method_changed_on_redirect", "mentions": ["get", "301"]}},
    {"id": "e03", "audience": "experienced", "title": "expired JWT",
     "curl": "curl -H 'Authorization: Bearer {expired_jwt}' {base}/v1/me",
     "expect": {"category": "auth_expired", "mentions": ["expired"]}},
    {"id": "e04", "audience": "experienced", "title": "JWT not valid yet (clock)",
     "curl": "curl -H 'Authorization: Bearer {future_jwt}' {base}/v1/me",
     "expect": {"category": "auth_not_yet_valid", "mentions": ["clock", "not valid", "nbf"]}},
    {"id": "e05", "audience": "experienced", "title": "valid token, missing scope",
     "curl": "curl -H 'Authorization: Bearer good-token' {base}/v1/admin/users",
     "expect": {"category": "auth_scope", "mentions": ["admin", "scope"]}},
    {"id": "e06", "audience": "experienced", "title": "JWT with read scope on admin endpoint",
     "curl": "curl -H 'Authorization: Bearer {read_jwt}' {base}/v1/admin/users",
     "expect": {"category": "auth_scope", "mentions": ["admin", "scope"]}},
    {"id": "e07", "audience": "experienced", "title": "tampered JWT signature",
     "curl": "curl -H 'Authorization: Bearer {tampered_jwt}' {base}/v1/me",
     "expect": {"category": "auth_invalid", "mentions": ["signature", "token"]}},
    {"id": "e08", "audience": "experienced", "title": "rate limited",
     "curl": "curl {base}/v1/limited",
     "expect": {"category": "rate_limited", "mentions": ["retry", "rate"]}},
    {"id": "e09", "audience": "experienced", "title": "200 with an error body",
     "curl": "curl {base}/v1/quota",
     "expect": {"category": "error_in_success", "mentions": ["quota", "body"]}},
    {"id": "e10", "audience": "experienced", "title": "406 Not Acceptable",
     "curl": "curl -H 'Accept: text/csv' {base}/v1/report",
     "expect": {"category": "not_acceptable", "mentions": ["accept"]}},
    {"id": "e11", "audience": "experienced", "title": "server error",
     "curl": "curl {base}/v1/broken",
     "expect": {"category": "server_error", "mentions": ["server", "retry"]}},

    {"id": "h01", "audience": "hard", "title": "vague 400: date in the wrong format",
     "curl": "curl '{base}/v1/search?date_from=05/10/2026'",
     "expect": {"category": "bad_parameter", "mentions": ["iso", "yyyy-mm-dd", "2026-10-05"]}},
    {"id": "h02", "audience": "hard", "title": "400 reason given as a plain string",
     "curl": "curl '{base}/v1/list?page_size=500'",
     "expect": {"category": "bad_parameter", "mentions": ["page_size", "100"]}},
    {"id": "h03", "audience": "hard", "title": "422 in a non-standard error shape",
     "curl": "curl --json '{\"amount\": -5}' {base}/v1/payments", "allow_unsafe": true,
     "expect": {"category": "validation", "mentions": ["amount", "positive"]}},
    {"id": "h04", "audience": "hard", "title": "opaque token expired (message only)",
     "curl": "curl -H 'Authorization: Bearer legacy-2fa81c' {base}/v1/legacy/me",
     "expect": {"category": "auth_expired", "mentions": ["expired"]}},
    {"id": "h05", "audience": "hard", "title": "SSO redirect ends on a 200 HTML login page",
     "curl": "curl -L {base}/v1/sso-report",
     "expect": {"category": "auth_missing", "mentions": ["login", "sign in", "session", "html"]}}
  ]
}